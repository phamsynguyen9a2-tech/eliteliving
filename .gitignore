# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
web/.env
web/.env.*
!web/.env.example

# Documents & Unrelated binaries
*.pdf
*.docx
New folder/
PPNCKH/
ezhouse-booking-app/
web/scratch/


