node_modules/
web/node_modules/
.next/
web/.next/
web/out/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python & Virtual Environments
.venv/
venv/
ENV/
env/
