// Prisma Schema for PhongTro Recommender System
// Database: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum RoomStatus {
  AVAILABLE
  BOOKED_VIEWING
  RESERVED
  RENTED
}

/// Trạng thái kiểm duyệt tin đăng phòng: chỉ tin APPROVED mới hiện công khai
enum ListingStatus {
  PENDING  // chủ trọ vừa đăng / vừa sửa nội dung, chờ admin duyệt
  APPROVED // đã duyệt, hiện trên tìm kiếm, gợi ý, đặt lịch
  REJECTED // bị từ chối (kèm lý do), chủ trọ sửa lại để gửi duyệt lại
}

enum UserRole {
  TENANT
  LANDLORD
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum BillStatus {
  UNPAID
  PAID
}

enum InteractionAction {
  VIEW
  BOOKMARK
  BOOK_VIEWING
}

/// Trạng thái khách báo đã chuyển khoản hóa đơn
enum PaymentClaimStatus {
  PENDING_CONFIRMATION // chờ chủ trọ đối soát
  CONFIRMED            // chủ trọ đã xác nhận nhận tiền
}

/// Trạng thái yêu cầu đặt cọc giữ chỗ
enum DepositClaimStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
}

enum MaintenanceCategory {
  ELECTRICAL
  PLUMBING
  AC_APPLIANCE
  DOOR_LOCK
  OTHER
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

/// Hành động trên một phòng nằm trong danh sách gợi ý Top-K
enum RecommendationEventType {
  CLICK // mở trang chi tiết phòng từ danh sách gợi ý
  BOOK  // đặt lịch xem phòng từ danh sách gợi ý
}

enum RoommatePostStatus {
  OPEN
  CLOSED
  FULL
}

enum RoommateRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum HandoverType {
  CHECK_IN
  CHECK_OUT
}

enum HandoverStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  DISPUTED
}

// ============================================================
// MODELS — NextAuth (OAuth)
// ============================================================

/// OAuth Account — lưu thông tin provider (Google, ...)
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Session — phiên đăng nhập
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Verification Token — xác minh email (NextAuth)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// MODELS — Core Business
// ============================================================

/// Chủ trọ - Landlord
model Landlord {
  id        String   @id
  name      String
  phone     String
  email     String
  role      String   @default("LANDLORD")
  avatar    String   @default("")
  // scrypt hash, đặt bằng: npx tsx scripts/set-portal-password.ts <email> <mật khẩu>
  // null = chưa được cấp mật khẩu (chỉ vào được bằng mật khẩu demo khi bật chế độ demo)
  passwordHash String? @map("password_hash")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  projects Project[]
  rooms    Room[]

  @@map("landlords")
}

/// Dự án / Tòa nhà - Building/Project
model Project {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  code         String   @unique
  name         String
  address      String
  district     String   @default("Quận Tân Phú")
  lat          Float
  lng          Float
  basePrice    Float    @map("base_price")
  roomType     String   @map("room_type")
  area         Float
  amenities    String[]
  images       String[]
  landlordId   String   @map("landlord_id")
  landlordName  String  @map("landlord_name")
  landlordPhone String  @map("landlord_phone")

  // Relations
  landlord Landlord @relation(fields: [landlordId], references: [id])
  rooms    Room[]

  @@map("projects")
}

/// Phòng trọ - Room
model Room {
  id              Int        @id
  roomCode        String     @map("room_code")
  projectCode     String?    @map("project_code")
  projectName     String?    @map("project_name")
  floor           Int?
  unitNumber      Int?       @map("unit_number")
  hasBalcony      Boolean?   @map("has_balcony")
  title           String
  price           Float
  deposit         Float
  area            Float
  roomType        String     @map("room_type")
  address         String
  district        String
  latitude        Float
  longitude       Float
  distanceToHuitKm Float?   @map("distance_to_huit_km")
  amenities       String[]
  images          String[]
  status          RoomStatus @default(AVAILABLE)
  landlordId      String     @map("landlord_id")
  landlordName    String     @map("landlord_name")
  landlordPhone   String     @map("landlord_phone")
  electricityRate Float      @map("electricity_rate")
  waterRate       Float      @map("water_rate")
  internetFee     Float      @map("internet_fee")
  serviceFee      Float      @map("service_fee")
  parkingFee      Float      @map("parking_fee")
  description     String     @default("")

  // Kiểm duyệt tin đăng (phòng có sẵn trước khi có kiểm duyệt được coi là đã duyệt)
  listingStatus  ListingStatus @default(APPROVED) @map("listing_status")
  moderationNote String?       @map("moderation_note")
  submittedAt    DateTime?     @map("submitted_at")
  moderatedAt    DateTime?     @map("moderated_at")

  // Relations
  landlord       Landlord        @relation(fields: [landlordId], references: [id])
  project        Project?        @relation(fields: [projectCode], references: [code])
  appointments   Appointment[]
  contracts      Contract[]
  utilityBills   UtilityBill[]
  interactions   InteractionLog[]
  roommatePosts  RoommatePost[]
  assetTemplates AssetTemplate[]
  handovers      Handover[]
  savedBy        SavedRoom[]
  recommendationEvents RecommendationEvent[]
  depositClaims  DepositClaim[]
  maintenanceRequests MaintenanceRequest[]
  reviews        Review[]

  @@index([listingStatus])
  @@map("rooms")
}

/// Người dùng - User / Tenant
model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String    @default("")
  role            UserRole  @default(TENANT)
  emailVerified   DateTime? @map("email_verified")
  phoneVerified   Boolean   @default(false) @map("phone_verified")
  image           String?
  googleId        String?   @unique @map("google_id")
  // scrypt hash cho đăng nhập Email/SĐT + mật khẩu; null = tài khoản cũ / OTP / Google chưa đặt mật khẩu
  passwordHash    String?   @map("password_hash")

  // Spam control
  spamScore        Int       @default(0) @map("spam_score")
  isBlocked        Boolean   @default(false) @map("is_blocked")
  lastActionAt     DateTime? @map("last_action_at")
  dailyActionCount Int       @default(0) @map("daily_action_count")

  // Preferences (for recommender)
  budgetMax          Float?   @map("budget_max")
  preferredDistrict  String?  @map("preferred_district")
  preferredAmenities String[] @map("preferred_amenities")
  targetLat          Float?   @map("target_lat")
  targetLng          Float?   @map("target_lng")
  maxRadiusKm        Float?   @map("max_radius_km")

  createdAt DateTime @default(now()) @map("created_at")

  // NextAuth Relations
  accounts     Account[]
  sessions     Session[]

  // Existing Relations
  appointments Appointment[]
  interactions InteractionLog[]
  savedRooms   SavedRoom[]
  recommendationImpressions RecommendationImpression[]
  reviews      Review[]
  deviceTokens DeviceToken[]

  // Roommate Relations
  roommateProfile   RoommateProfile?
  roommatePosts     RoommatePost[]
  roommateRequests  RoommateRequest[] @relation("RoommateRequests")

  @@map("users")
}

/// Lịch hẹn xem phòng - Appointment
model Appointment {
  id        String            @id @default(cuid())
  roomId    Int               @map("room_id")
  userId    String            @map("user_id")
  userName  String            @map("user_name")
  userPhone String            @map("user_phone")
  date      String            // YYYY-MM-DD
  timeSlot  String            @map("time_slot")
  status    AppointmentStatus @default(PENDING)
  notes     String?
  createdAt DateTime          @default(now()) @map("created_at")

  // Relations
  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  // Unique constraint for concurrency control: prevent double-booking
  @@unique([roomId, date, timeSlot], name: "unique_slot_booking")
  @@map("appointments")
}

/// Hợp đồng thuê - Contract
model Contract {
  id           String         @id @default(cuid())
  roomId       Int            @map("room_id")
  roomTitle    String         @map("room_title")
  tenantName   String         @map("tenant_name")
  tenantPhone     String         @map("tenant_phone")
  tenantCitizenId String?        @map("tenant_citizen_id")
  tenantAddress   String?        @map("tenant_address")
  vehicleCount    Int            @default(0) @map("vehicle_count")
  landlordName String         @map("landlord_name")
  startDate    String         @map("start_date")
  endDate      String         @map("end_date")
  monthlyRent  Float          @map("monthly_rent")
  depositAmount Float         @map("deposit_amount")
  status       ContractStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")

  // Relations
  room      Room          @relation(fields: [roomId], references: [id])
  handovers Handover[]
  bills     UtilityBill[]

  @@map("contracts")
}

/// Hóa đơn tiện ích - Utility Bill
model UtilityBill {
  id           String     @id @default(cuid())
  roomId       Int        @map("room_id")
  roomCode     String     @map("room_code")
  month        String     // MM/YYYY
  electricOld  Float      @map("electric_old")
  electricNew  Float      @map("electric_new")
  electricUsed Float      @map("electric_used")
  electricCost Float      @map("electric_cost")
  waterOld     Float      @map("water_old")
  waterNew     Float      @map("water_new")
  waterUsed    Float      @map("water_used")
  waterCost    Float      @map("water_cost")
  internetCost Float      @map("internet_cost")
  serviceCost  Float      @map("service_cost")
  rentCost     Float      @map("rent_cost")
  totalAmount  Float      @map("total_amount")
  status       BillStatus @default(UNPAID)
  createdAt    DateTime   @default(now()) @map("created_at")
  // Hợp đồng mà hóa đơn thuộc về: khách thuê chỉ thấy hóa đơn của hợp đồng của mình.
  // null = hóa đơn cũ lập trước khi có cột này (gắn lại bằng scripts/backfill-bill-contracts.ts)
  contractId   String?    @map("contract_id")

  // Relations
  room     Room         @relation(fields: [roomId], references: [id])
  contract Contract?    @relation(fields: [contractId], references: [id])
  payment  BillPayment?

  // Mỗi phòng chỉ có một hóa đơn cho mỗi kỳ (chặn lập trùng cả khi bấm 2 lần cùng lúc)
  @@unique([roomId, month])
  @@index([contractId])
  @@map("utility_bills")
}

/// Lịch sử tương tác - Interaction Log (for recommender)
model InteractionLog {
  id        Int               @id @default(autoincrement())
  userId    String            @map("user_id")
  roomId    Int               @map("room_id")
  action    InteractionAction
  timestamp DateTime          @default(now())
  rating    Float             @default(0)

  // Relations
  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@index([userId, timestamp])
  @@map("interaction_logs")
}

/// Phòng khách thuê đã lưu (nút tim ở trang chi tiết phòng)
model SavedRoom {
  userId    String   @map("user_id")
  roomId    Int      @map("room_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@map("saved_rooms")
}

/// Một lần danh sách gợi ý Top-K được hiển thị (để đo CTR và tỉ lệ chuyển đổi)
model RecommendationImpression {
  id        String   @id // UUID do API gợi ý tạo và trả về cùng danh sách
  userId    String?  @map("user_id") // null = khách chưa đăng nhập
  source    String // WEB_TOPK (trang chủ web), MOBILE_HOME (màn hình chính app)
  roomIds   Int[]    @map("room_ids") // các phòng được hiển thị, theo thứ tự xếp hạng
  itemCount Int      @map("item_count")
  createdAt DateTime @default(now()) @map("created_at")

  user   User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  events RecommendationEvent[]

  @@index([createdAt])
  @@map("recommendation_impressions")
}

/// Người dùng mở chi tiết / đặt lịch một phòng NẰM TRONG danh sách gợi ý đã hiển thị
model RecommendationEvent {
  id           Int                     @id @default(autoincrement())
  impressionId String                  @map("impression_id")
  roomId       Int                     @map("room_id")
  action       RecommendationEventType
  createdAt    DateTime                @default(now()) @map("created_at")

  impression RecommendationImpression @relation(fields: [impressionId], references: [id], onDelete: Cascade)
  room       Room                     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([impressionId, roomId, action])
  @@map("recommendation_events")
}

/// Khách thuê báo đã chuyển khoản một hóa đơn (kèm mã giao dịch); chủ trọ đối soát và xác nhận.
/// Đây là lịch sử giao dịch thanh toán giả lập của hệ thống.
model BillPayment {
  id              String             @id @default(cuid())
  billId          String             @unique @map("bill_id")
  roomId          Int                @map("room_id")
  tenantId        String?            @map("tenant_id")
  tenantName      String             @map("tenant_name")
  tenantPhone     String             @default("") @map("tenant_phone")
  transactionCode String             @map("transaction_code")
  status          PaymentClaimStatus @default(PENDING_CONFIRMATION)
  reportedAt      DateTime           @default(now()) @map("reported_at")
  confirmedAt     DateTime?          @map("confirmed_at")

  bill UtilityBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("bill_payments")
}

/// Yêu cầu đặt cọc giữ chỗ: khách gửi mã giao dịch và thông tin CCCD, chủ trọ đối soát rồi lập hợp đồng.
/// Lưu lại mọi lần đặt cọc (lịch sử); yêu cầu hiện hành của phòng là bản ghi mới nhất.
model DepositClaim {
  id              String             @id @default(cuid())
  roomId          Int                @map("room_id")
  appointmentId   String?            @map("appointment_id")
  tenantId        String?            @map("tenant_id")
  tenantName      String             @map("tenant_name")
  tenantPhone     String             @map("tenant_phone")
  tenantCitizenId String             @map("tenant_citizen_id")
  tenantAddress   String             @default("") @map("tenant_address")
  depositAmount   Float              @map("deposit_amount")
  moveInDate      String             @map("move_in_date") // YYYY-MM-DD
  vehicleCount    Int                @default(0) @map("vehicle_count")
  transactionCode String             @map("transaction_code")
  notes           String?
  status          DepositClaimStatus @default(PENDING_CONFIRMATION)
  createdAt       DateTime           @default(now()) @map("created_at")
  confirmedAt     DateTime?          @map("confirmed_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("deposit_claims")
}

/// Cấu hình của chủ trọ: khung giờ đón khách xem phòng và bộ nội quy & PCCC.
/// landlordId = mã chủ trọ, hoặc "default" cho nội quy mặc định của hệ thống.
model LandlordSetting {
  landlordId   String   @id @map("landlord_id")
  availability Json?
  houseRules   Json?    @map("house_rules")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("landlord_configs")
}

/// Phiếu yêu cầu sửa chữa / bảo trì phòng
model MaintenanceRequest {
  id             String              @id @default(cuid())
  roomId         Int                 @map("room_id")
  roomCode       String              @map("room_code")
  landlordId     String              @map("landlord_id")
  tenantName     String              @map("tenant_name")
  tenantPhone    String              @default("") @map("tenant_phone")
  category       MaintenanceCategory @default(OTHER)
  priority       MaintenancePriority @default(MEDIUM)
  title          String
  description    String              @default("")
  status         MaintenanceStatus   @default(PENDING)
  repairCost     Float               @default(0) @map("repair_cost")
  resolutionNote String?             @map("resolution_note")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([landlordId, createdAt])
  @@map("maintenance_requests")
}

/// Thông báo trong hộp thư khách thuê (kèm nội dung email đã gửi). Trước đây lưu trong file .data/notifications.json.
/// Người nhận khớp theo email, tài khoản (recipientUserId) hoặc SĐT đã xác minh.
model Notification {
  id              String   @id
  recipientEmail  String   @map("recipient_email")
  recipientName   String   @map("recipient_name")
  recipientUserId String?  @map("recipient_user_id")
  recipientPhone  String?  @map("recipient_phone")
  type            String
  subject         String
  summary         String
  contentHtml     String   @map("content_html")
  link            String?
  metadata        Json?
  isRead          Boolean  @default(false) @map("is_read")
  sentAt          DateTime @default(now()) @map("sent_at")

  @@index([recipientUserId])
  @@index([recipientEmail])
  @@index([recipientPhone])
  @@index([sentAt])
  @@map("notifications")
}

/// Đánh giá / phản hồi của người thuê về phòng đã thuê hoặc đã đi xem.
/// Mỗi người một đánh giá cho mỗi phòng (sửa lại thì cập nhật); chủ trọ trả lời; admin ẩn đánh giá vi phạm.
model Review {
  id            String    @id @default(cuid())
  roomId        Int       @map("room_id")
  userId        String    @map("user_id")
  rating        Int // 1 - 5 sao
  comment       String    @default("")
  landlordReply String?   @map("landlord_reply")
  repliedAt     DateTime? @map("replied_at")
  isHidden      Boolean   @default(false) @map("is_hidden")
  hiddenReason  String?   @map("hidden_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, createdAt])
  @@map("reviews")
}

/// Nhật ký tìm kiếm phòng (để thống kê khu vực có nhu cầu tìm kiếm cao)
model SearchLog {
  id          Int      @id @default(autoincrement())
  userId      String?  @map("user_id")
  source      String // WEB_SEARCH, MOBILE_SEARCH, MOBILE_NEARBY
  district    String?
  keyword     String?
  minPrice    Float?   @map("min_price")
  maxPrice    Float?   @map("max_price")
  roomType    String?  @map("room_type")
  amenities   String[]
  resultCount Int      @default(0) @map("result_count")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([district])
  @@map("search_logs")
}

/// Mã thiết bị nhận thông báo đẩy (Firebase Cloud Messaging) của app người thuê
model DeviceToken {
  token     String   @id
  userId    String   @map("user_id")
  platform  String   @default("android")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

/// Danh mục tiện ích dùng chung (admin quản lý, chủ trọ chọn khi đăng phòng)
model Amenity {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  category  String   @default("Tiện ích")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("amenities")
}

/// Cấu hình hệ thống dạng khóa - giá trị (VD: pricing_defaults = đơn giá điện, nước, dịch vụ mặc định)
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ============================================================
// MODELS — Ở ghép (Roommate Matching)
// ============================================================

/// Hồ sơ ở ghép cá nhân
model RoommateProfile {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  gender        String   @default("Khác")
  age           Int?
  occupation    String?
  habits        String[]
  preferences   String[]
  bio           String?
  lifestyle     String?
  petFriendly   Boolean  @default(false) @map("pet_friendly")
  smokingStatus Boolean  @default(false) @map("smoking_status")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("roommate_profiles")
}

/// Bài đăng tìm người ở ghép
model RoommatePost {
  id               String             @id @default(cuid())
  roomId           Int                @map("room_id")
  userId           String             @map("user_id")
  title            String
  description      String
  sharedRent       Float              @map("shared_rent")
  maxPeople        Int                @default(2) @map("max_people")
  currentPeople    Int                @default(1) @map("current_people")
  genderPreference String             @default("Không yêu cầu") @map("gender_preference")
  requiredHabits   String[]           @map("required_habits")
  status           RoommatePostStatus @default(OPEN)
  images           String[]
  contactPhone     String             @map("contact_phone")
  district         String             @default("")
  address          String             @default("")
  createdAt        DateTime           @default(now()) @map("created_at")
  expiresAt        DateTime           @map("expires_at")

  room     Room              @relation(fields: [roomId], references: [id])
  user     User              @relation(fields: [userId], references: [id])
  requests RoommateRequest[]

  @@map("roommate_posts")
}

/// Yêu cầu ở ghép
model RoommateRequest {
  id          String                @id @default(cuid())
  postId      String                @map("post_id")
  requesterId String                @map("requester_id")
  message     String?
  status      RoommateRequestStatus @default(PENDING)
  createdAt   DateTime              @default(now()) @map("created_at")

  post      RoommatePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  requester User         @relation("RoommateRequests", fields: [requesterId], references: [id])

  @@unique([postId, requesterId])
  @@map("roommate_requests")
}

// ============================================================
// MODELS — Bàn giao Cơ sở vật chất
// ============================================================

/// Template tài sản mặc định cho phòng
model AssetTemplate {
  id       String @id @default(cuid())
  roomId   Int    @map("room_id")
  name     String
  category String @default("Nội thất")
  quantity Int    @default(1)

  room Room @relation(fields: [roomId], references: [id])

  @@map("asset_templates")
}

/// Biên bản bàn giao cơ sở vật chất
model Handover {
  id                String         @id @default(cuid())
  contractId        String         @map("contract_id")
  roomId            Int            @map("room_id")
  type              HandoverType
  tenantName        String         @map("tenant_name")
  tenantPhone       String         @map("tenant_phone")
  landlordName      String         @map("landlord_name")
  status            HandoverStatus @default(DRAFT)
  tenantConfirmed   Boolean        @default(false) @map("tenant_confirmed")
  landlordConfirmed Boolean        @default(false) @map("landlord_confirmed")
  notes             String?
  damageCost        Float          @default(0) @map("damage_cost")
  handoverDate      DateTime       @map("handover_date")
  createdAt         DateTime       @default(now()) @map("created_at")

  contract Contract      @relation(fields: [contractId], references: [id])
  room     Room           @relation(fields: [roomId], references: [id])
  items    HandoverItem[]

  @@map("handovers")
}

/// Chi tiết tài sản trong biên bản bàn giao
model HandoverItem {
  id            String  @id @default(cuid())
  handoverId    String  @map("handover_id")
  assetName     String  @map("asset_name")
  category      String  @default("Nội thất")
  quantity      Int     @default(1)
  condition     String  @default("Tốt")
  photos        String[]
  note          String?
  estimatedCost Float   @default(0) @map("estimated_cost")

  handover Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@map("handover_items")
}
