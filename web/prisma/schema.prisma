// Prisma Schema for PhongTro Recommender System
// Database: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum RoomStatus {
  AVAILABLE
  BOOKED_VIEWING
  RESERVED
  RENTED
}

enum UserRole {
  TENANT
  LANDLORD
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum BillStatus {
  UNPAID
  PAID
}

enum InteractionAction {
  VIEW
  BOOKMARK
  BOOK_VIEWING
}

enum RoommatePostStatus {
  OPEN
  CLOSED
  FULL
}

enum RoommateRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum HandoverType {
  CHECK_IN
  CHECK_OUT
}

enum HandoverStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  DISPUTED
}

// ============================================================
// MODELS — NextAuth (OAuth)
// ============================================================

/// OAuth Account — lưu thông tin provider (Google, ...)
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Session — phiên đăng nhập
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Verification Token — xác minh email (NextAuth)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// MODELS — Core Business
// ============================================================

/// Chủ trọ - Landlord
model Landlord {
  id        String   @id
  name      String
  phone     String
  email     String
  role      String   @default("LANDLORD")
  avatar    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  projects Project[]
  rooms    Room[]

  @@map("landlords")
}

/// Dự án / Tòa nhà - Building/Project
model Project {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  code         String   @unique
  name         String
  address      String
  district     String   @default("Quận Tân Phú")
  lat          Float
  lng          Float
  basePrice    Float    @map("base_price")
  roomType     String   @map("room_type")
  area         Float
  amenities    String[]
  images       String[]
  landlordId   String   @map("landlord_id")
  landlordName  String  @map("landlord_name")
  landlordPhone String  @map("landlord_phone")

  // Relations
  landlord Landlord @relation(fields: [landlordId], references: [id])
  rooms    Room[]

  @@map("projects")
}

/// Phòng trọ - Room
model Room {
  id              Int        @id
  roomCode        String     @map("room_code")
  projectCode     String?    @map("project_code")
  projectName     String?    @map("project_name")
  floor           Int?
  unitNumber      Int?       @map("unit_number")
  hasBalcony      Boolean?   @map("has_balcony")
  title           String
  price           Float
  deposit         Float
  area            Float
  roomType        String     @map("room_type")
  address         String
  district        String
  latitude        Float
  longitude       Float
  distanceToHuitKm Float?   @map("distance_to_huit_km")
  amenities       String[]
  images          String[]
  status          RoomStatus @default(AVAILABLE)
  landlordId      String     @map("landlord_id")
  landlordName    String     @map("landlord_name")
  landlordPhone   String     @map("landlord_phone")
  electricityRate Float      @map("electricity_rate")
  waterRate       Float      @map("water_rate")
  internetFee     Float      @map("internet_fee")
  serviceFee      Float      @map("service_fee")
  parkingFee      Float      @map("parking_fee")
  description     String     @default("")

  // Relations
  landlord       Landlord        @relation(fields: [landlordId], references: [id])
  project        Project?        @relation(fields: [projectCode], references: [code])
  appointments   Appointment[]
  contracts      Contract[]
  utilityBills   UtilityBill[]
  interactions   InteractionLog[]
  roommatePosts  RoommatePost[]
  assetTemplates AssetTemplate[]
  handovers      Handover[]

  @@map("rooms")
}

/// Người dùng - User / Tenant
model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String    @default("")
  role            UserRole  @default(TENANT)
  emailVerified   DateTime? @map("email_verified")
  phoneVerified   Boolean   @default(false) @map("phone_verified")
  image           String?
  googleId        String?   @unique @map("google_id")

  // Spam control
  spamScore        Int       @default(0) @map("spam_score")
  isBlocked        Boolean   @default(false) @map("is_blocked")
  lastActionAt     DateTime? @map("last_action_at")
  dailyActionCount Int       @default(0) @map("daily_action_count")

  // Preferences (for recommender)
  budgetMax          Float?   @map("budget_max")
  preferredDistrict  String?  @map("preferred_district")
  preferredAmenities String[] @map("preferred_amenities")
  targetLat          Float?   @map("target_lat")
  targetLng          Float?   @map("target_lng")
  maxRadiusKm        Float?   @map("max_radius_km")

  createdAt DateTime @default(now()) @map("created_at")

  // NextAuth Relations
  accounts     Account[]
  sessions     Session[]

  // Existing Relations
  appointments Appointment[]
  interactions InteractionLog[]

  // Roommate Relations
  roommateProfile   RoommateProfile?
  roommatePosts     RoommatePost[]
  roommateRequests  RoommateRequest[] @relation("RoommateRequests")

  @@map("users")
}

/// Lịch hẹn xem phòng - Appointment
model Appointment {
  id        String            @id @default(cuid())
  roomId    Int               @map("room_id")
  userId    String            @map("user_id")
  userName  String            @map("user_name")
  userPhone String            @map("user_phone")
  date      String            // YYYY-MM-DD
  timeSlot  String            @map("time_slot")
  status    AppointmentStatus @default(PENDING)
  notes     String?
  createdAt DateTime          @default(now()) @map("created_at")

  // Relations
  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  // Unique constraint for concurrency control: prevent double-booking
  @@unique([roomId, date, timeSlot], name: "unique_slot_booking")
  @@map("appointments")
}

/// Hợp đồng thuê - Contract
model Contract {
  id           String         @id @default(cuid())
  roomId       Int            @map("room_id")
  roomTitle    String         @map("room_title")
  tenantName   String         @map("tenant_name")
  tenantPhone  String         @map("tenant_phone")
  landlordName String         @map("landlord_name")
  startDate    String         @map("start_date")
  endDate      String         @map("end_date")
  monthlyRent  Float          @map("monthly_rent")
  depositAmount Float         @map("deposit_amount")
  status       ContractStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")

  // Relations
  room      Room       @relation(fields: [roomId], references: [id])
  handovers Handover[]

  @@map("contracts")
}

/// Hóa đơn tiện ích - Utility Bill
model UtilityBill {
  id           String     @id @default(cuid())
  roomId       Int        @map("room_id")
  roomCode     String     @map("room_code")
  month        String     // MM/YYYY
  electricOld  Float      @map("electric_old")
  electricNew  Float      @map("electric_new")
  electricUsed Float      @map("electric_used")
  electricCost Float      @map("electric_cost")
  waterOld     Float      @map("water_old")
  waterNew     Float      @map("water_new")
  waterUsed    Float      @map("water_used")
  waterCost    Float      @map("water_cost")
  internetCost Float      @map("internet_cost")
  serviceCost  Float      @map("service_cost")
  rentCost     Float      @map("rent_cost")
  totalAmount  Float      @map("total_amount")
  status       BillStatus @default(UNPAID)
  createdAt    DateTime   @default(now()) @map("created_at")

  // Relations
  room Room @relation(fields: [roomId], references: [id])

  @@map("utility_bills")
}

/// Lịch sử tương tác - Interaction Log (for recommender)
model InteractionLog {
  id        Int               @id @default(autoincrement())
  userId    String            @map("user_id")
  roomId    Int               @map("room_id")
  action    InteractionAction
  timestamp DateTime          @default(now())
  rating    Float             @default(0)

  // Relations
  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@map("interaction_logs")
}

// ============================================================
// MODELS — Ở ghép (Roommate Matching)
// ============================================================

/// Hồ sơ ở ghép cá nhân
model RoommateProfile {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  gender        String   @default("Khác")
  age           Int?
  occupation    String?
  habits        String[]
  preferences   String[]
  bio           String?
  lifestyle     String?
  petFriendly   Boolean  @default(false) @map("pet_friendly")
  smokingStatus Boolean  @default(false) @map("smoking_status")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("roommate_profiles")
}

/// Bài đăng tìm người ở ghép
model RoommatePost {
  id               String             @id @default(cuid())
  roomId           Int                @map("room_id")
  userId           String             @map("user_id")
  title            String
  description      String
  sharedRent       Float              @map("shared_rent")
  maxPeople        Int                @default(2) @map("max_people")
  currentPeople    Int                @default(1) @map("current_people")
  genderPreference String             @default("Không yêu cầu") @map("gender_preference")
  requiredHabits   String[]           @map("required_habits")
  status           RoommatePostStatus @default(OPEN)
  images           String[]
  contactPhone     String             @map("contact_phone")
  district         String             @default("")
  address          String             @default("")
  createdAt        DateTime           @default(now()) @map("created_at")
  expiresAt        DateTime           @map("expires_at")

  room     Room              @relation(fields: [roomId], references: [id])
  user     User              @relation(fields: [userId], references: [id])
  requests RoommateRequest[]

  @@map("roommate_posts")
}

/// Yêu cầu ở ghép
model RoommateRequest {
  id          String                @id @default(cuid())
  postId      String                @map("post_id")
  requesterId String                @map("requester_id")
  message     String?
  status      RoommateRequestStatus @default(PENDING)
  createdAt   DateTime              @default(now()) @map("created_at")

  post      RoommatePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  requester User         @relation("RoommateRequests", fields: [requesterId], references: [id])

  @@unique([postId, requesterId])
  @@map("roommate_requests")
}

// ============================================================
// MODELS — Bàn giao Cơ sở vật chất
// ============================================================

/// Template tài sản mặc định cho phòng
model AssetTemplate {
  id       String @id @default(cuid())
  roomId   Int    @map("room_id")
  name     String
  category String @default("Nội thất")
  quantity Int    @default(1)

  room Room @relation(fields: [roomId], references: [id])

  @@map("asset_templates")
}

/// Biên bản bàn giao cơ sở vật chất
model Handover {
  id                String         @id @default(cuid())
  contractId        String         @map("contract_id")
  roomId            Int            @map("room_id")
  type              HandoverType
  tenantName        String         @map("tenant_name")
  tenantPhone       String         @map("tenant_phone")
  landlordName      String         @map("landlord_name")
  status            HandoverStatus @default(DRAFT)
  tenantConfirmed   Boolean        @default(false) @map("tenant_confirmed")
  landlordConfirmed Boolean        @default(false) @map("landlord_confirmed")
  notes             String?
  damageCost        Float          @default(0) @map("damage_cost")
  handoverDate      DateTime       @map("handover_date")
  createdAt         DateTime       @default(now()) @map("created_at")

  contract Contract      @relation(fields: [contractId], references: [id])
  room     Room           @relation(fields: [roomId], references: [id])
  items    HandoverItem[]

  @@map("handovers")
}

/// Chi tiết tài sản trong biên bản bàn giao
model HandoverItem {
  id            String  @id @default(cuid())
  handoverId    String  @map("handover_id")
  assetName     String  @map("asset_name")
  category      String  @default("Nội thất")
  quantity      Int     @default(1)
  condition     String  @default("Tốt")
  photos        String[]
  note          String?
  estimatedCost Float   @default(0) @map("estimated_cost")

  handover Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@map("handover_items")
}
