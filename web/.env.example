# ===========================================
# Supabase PostgreSQL Connection
# ===========================================
# Thay thế bằng connection string từ Supabase Dashboard
# Settings > Database > Connection String > URI
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (dùng cho Prisma migrations)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ===========================================
# NextAuth (bắt buộc)
# ===========================================
# Địa chỉ web đang chạy
NEXTAUTH_URL="http://localhost:3000"
# Chuỗi bí mật mã hóa phiên đăng nhập: tự đặt một chuỗi ngẫu nhiên dài,
# ví dụ tạo bằng lệnh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="thay-bang-chuoi-ngau-nhien-dai"

# ===========================================
# Google OAuth (không bắt buộc)
# ===========================================
# Điền cả hai thì nút "Tiếp tục với Google" dùng Google thật.
# Để trống: khi bật chế độ demo, nút đổi thành "Vào tài khoản demo (Google)" và chỉ vào
# đúng một tài khoản demo cố định; khi tắt chế độ demo, nút bị ẩn.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================
# Chế độ demo (dùng cho buổi bảo vệ)
# ===========================================
# Chạy `npm run dev`: chế độ demo luôn bật.
# Chạy production (build + start, Vercel): chỉ bật khi đặt "true".
# Chế độ demo gồm: nút đăng nhập 1-click ở /portal/login, mật khẩu demo 123456 (chủ trọ) /
# admin123 (admin) cho tài khoản CHƯA được cấp mật khẩu riêng, nút Google demo, mã OTP in ra terminal
# đang chạy máy chủ (tài khoản demo thì hiện luôn trên màn hình).
ENABLE_DEMO_LOGIN=""

# ===========================================
# Mật khẩu Cổng Chủ trọ & Quản trị viên
# ===========================================
# Mỗi chủ trọ / admin có mật khẩu riêng (cột password_hash). Cấp hoặc đổi mật khẩu bằng:
#   npx tsx scripts/set-portal-password.ts <email hoặc SĐT> <mật khẩu mới>
# (cần chạy `npx prisma db push` một lần trước để có cột password_hash cho bảng landlords)
#
# Tùy chọn: mật khẩu cho tài khoản admin chưa có mật khẩu riêng.
ADMIN_PORTAL_PASSWORD=""

# ===========================================
# Gửi mã OTP (đăng nhập bằng OTP, quên mật khẩu)
# ===========================================
# Production: mã OTP chỉ được gửi qua email bằng Resend (https://resend.com, gói miễn phí).
# Không đặt RESEND_API_KEY thì ở production chức năng OTP báo "chưa cấu hình", khách thuê đăng nhập bằng mật khẩu.
RESEND_API_KEY=""
# Địa chỉ gửi. Với tài khoản Resend chưa xác minh domain, chỉ gửi được tới email của chính chủ tài khoản Resend.
EMAIL_FROM="Elite Living <onboarding@resend.dev>"
#
# Chế độ demo: mã OTP được in ra terminal của máy chủ. Chỉ các tài khoản trong danh sách dưới đây
# (cộng tài khoản demo nguyen.pham.huit@gmail.com / 0912345678) mới thấy mã ngay trên màn hình.
# Ví dụ: DEMO_OTP_ALLOWLIST="sv1@gmail.com,0901234567"
DEMO_OTP_ALLOWLIST=""
# "true" = hiện mã OTP trên màn hình cho MỌI tài khoản. KHÔNG an toàn: ai cũng lấy được mã của người khác.
# Chỉ dùng khi demo offline trên máy cá nhân, tuyệt đối không bật khi đưa web lên mạng.
DEMO_OTP_IN_RESPONSE=""
