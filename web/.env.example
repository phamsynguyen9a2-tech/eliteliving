# ===========================================
# Supabase PostgreSQL Connection
# ===========================================
# Thay thế bằng connection string từ Supabase Dashboard
# Settings > Database > Connection String > URI
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (dùng cho Prisma migrations)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ===========================================
# NextAuth (bắt buộc)
# ===========================================
# Địa chỉ web đang chạy
NEXTAUTH_URL="http://localhost:3000"
# Chuỗi bí mật mã hóa phiên đăng nhập: tự đặt một chuỗi ngẫu nhiên dài,
# ví dụ tạo bằng lệnh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="thay-bang-chuoi-ngau-nhien-dai"

# ===========================================
# Google OAuth (không bắt buộc)
# ===========================================
# Để trống thì web dùng nút "Đăng nhập Google (demo)" thay cho Google thật
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================
# Cổng Chủ trọ & Quản trị viên (không bắt buộc khi chạy npm run dev)
# ===========================================
# Khi chạy dev: để trống thì dùng mật khẩu demo (chủ trọ 123456, admin admin123)
# Khi chạy production: bắt buộc đặt mật khẩu, hoặc bật ENABLE_DEMO_PORTAL="true"
LANDLORD_PORTAL_PASSWORD=""
ADMIN_PORTAL_PASSWORD=""
ENABLE_DEMO_PORTAL=""
