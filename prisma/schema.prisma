// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =================== ENUMS ===================

enum UserRole {
  ADMIN
  LANDLORD
  TENANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum RoomStatus {
  AVAILABLE    // Còn trống
  SCHEDULED    // Đã đặt lịch xem
  RESERVED     // Đang giữ chỗ
  OCCUPIED     // Đã thuê
  MAINTENANCE  // Đang bảo trì
}

enum ScheduleStatus {
  PENDING    // Chờ xác nhận
  CONFIRMED  // Đã xác nhận
  CANCELLED  // Đã hủy
  COMPLETED  // Đã xem xong
}

enum ContractStatus {
  PENDING    // Chờ ký
  ACTIVE     // Đang thuê
  EXPIRED    // Hết hạn
  TERMINATED // Chấm dứt sớm
}

enum InvoiceStatus {
  UNPAID   // Chưa thanh toán
  PAID     // Đã thanh toán
  OVERDUE  // Quá hạn
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOMO
  ZALOPAY
}

// =================== MODELS ===================

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  phone     String?    @unique
  password  String
  fullName  String
  avatar    String?
  role      UserRole   @default(TENANT)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  landlordProfile LandlordProfile?
  tenantProfile   TenantProfile?
  viewSchedules   ViewSchedule[]   @relation("TenantSchedules")
  contracts       Contract[]       @relation("TenantContracts")
  payments        Payment[]
  reviews         Review[]
  searchLogs      SearchLog[]
  notifications   Notification[]

  @@map("users")
}

model LandlordProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String?
  taxCode     String?
  bankName    String?
  bankAccount String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  areas Area[]

  @@map("landlord_profiles")
}

model TenantProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  idCard           String?
  workplace        String?
  workplaceAddress String?
  workplaceLat     Float?
  workplaceLng     Float?
  budgetMin        Int?
  budgetMax        Int?
  preferredArea    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tenant_profiles")
}

model Area {
  id          String   @id @default(cuid())
  landlordId  String
  name        String
  address     String
  ward        String?
  district    String
  city        String   @default("TP.HCM")
  lat         Float?
  lng         Float?
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  landlord LandlordProfile @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  rooms    Room[]

  @@map("areas")
}

model Room {
  id          String     @id @default(cuid())
  areaId      String
  roomCode    String     @unique // VD: A101
  name        String
  floor       Int?
  area        Float      // Diện tích m2
  price       Int        // Giá thuê/tháng (VNĐ)
  deposit     Int        // Tiền cọc
  description String?
  status      RoomStatus @default(AVAILABLE)
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  areaRef       Area           @relation(fields: [areaId], references: [id], onDelete: Cascade)
  images        RoomImage[]
  amenities     RoomAmenity[]
  viewSchedules ViewSchedule[]
  contracts     Contract[]
  utilityUsages UtilityUsage[]
  reviews       Review[]
  searchLogs    SearchLog[]

  @@map("rooms")
}

model RoomImage {
  id        String   @id @default(cuid())
  roomId    String
  url       String
  caption   String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("room_images")
}

model Amenity {
  id       String  @id @default(cuid())
  name     String  @unique
  icon     String?
  category String? // "furniture", "appliance", "service"

  rooms RoomAmenity[]

  @@map("amenities")
}

model RoomAmenity {
  roomId    String
  amenityId String

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomId, amenityId])
  @@map("room_amenities")
}

model ViewSchedule {
  id          String         @id @default(cuid())
  roomId      String
  tenantId    String
  scheduledAt DateTime
  note        String?
  status      ScheduleStatus @default(PENDING)
  confirmedAt DateTime?
  cancelledAt DateTime?
  cancelReason String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenant User @relation("TenantSchedules", fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("view_schedules")
}

model Contract {
  id          String         @id @default(cuid())
  roomId      String
  tenantId    String
  startDate   DateTime
  endDate     DateTime
  monthlyRent Int
  deposit     Int
  electricRate Int           @default(3500) // VNĐ/kWh
  waterRate   Int            @default(15000) // VNĐ/m3
  status      ContractStatus @default(PENDING)
  signedAt    DateTime?
  terminatedAt DateTime?
  terminateReason String?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  room     Room     @relation(fields: [roomId], references: [id])
  tenant   User     @relation("TenantContracts", fields: [tenantId], references: [id])
  invoices Invoice[]

  @@map("contracts")
}

model UtilityUsage {
  id           String   @id @default(cuid())
  roomId       String
  month        Int      // 1-12
  year         Int
  prevElectric Int      @default(0) // kWh đầu kỳ
  currElectric Int      @default(0) // kWh cuối kỳ
  prevWater    Int      @default(0) // m3 đầu kỳ
  currWater    Int      @default(0) // m3 cuối kỳ
  recordedAt   DateTime @default(now())

  room    Room      @relation(fields: [roomId], references: [id])
  invoice Invoice[]

  @@unique([roomId, month, year])
  @@map("utility_usages")
}

model Invoice {
  id             String        @id @default(cuid())
  contractId     String
  utilityUsageId String?
  month          Int
  year           Int
  rentAmount     Int
  electricAmount Int           @default(0)
  waterAmount    Int           @default(0)
  otherAmount    Int           @default(0)
  totalAmount    Int
  dueDate        DateTime
  status         InvoiceStatus @default(UNPAID)
  paidAt         DateTime?
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  contract     Contract      @relation(fields: [contractId], references: [id])
  utilityUsage UtilityUsage? @relation(fields: [utilityUsageId], references: [id])
  payments     Payment[]

  @@map("invoices")
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  userId        String
  amount        Int
  method        PaymentMethod @default(BANK_TRANSFER)
  transactionId String?
  note          String?
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("payments")
}

model Review {
  id         String   @id @default(cuid())
  roomId     String
  userId     String
  rating     Int      // 1-5
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model SearchLog {
  id        String   @id @default(cuid())
  userId    String?
  roomId    String?
  action    String   // "search", "view", "schedule", "favorite"
  query     String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
  room Room? @relation(fields: [roomId], references: [id])

  @@map("search_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String   // "schedule", "contract", "invoice", "system"
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}
